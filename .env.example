# Copy to .env.local for local development. Never commit real values.
# All variables are server-only; the app defines no NEXT_PUBLIC_ variables.

# development | test | staging | production
APP_ENV=development

# unconfigured (default and only value until the tenant-realm identity contract is approved)
AUTH_ADAPTER=unconfigured

# Base64 of exactly 32 random bytes. Generate locally: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=

# Optional. Institution (tenant) API origin without a path; https is required in staging/production.
# When unset, the BFF answers 503 UPSTREAM_NOT_CONFIGURED.
TENANT_API_BASE_URL=

# Optional tuning.
API_TIMEOUT_MS=10000
SESSION_REFRESH_SKEW_SECONDS=60
